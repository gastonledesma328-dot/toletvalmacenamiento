<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- WebView principal -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Contenedor para FULLSCREEN HTML5 (onShowCustomView) -->
    <FrameLayout
        android:id="@+id/webFullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- OVERLAY DE ZAPPING -->
    <FrameLayout
        android:id="@+id/zappingOverlay"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="#CC111213"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <!-- Scrim superior -->
        <ImageView
            android:id="@+id/zapScrimTop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_backdrop_gradient_top"
            android:contentDescription="@null" />

        <!-- Header -->
        <LinearLayout
            android:id="@+id/zapHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/zapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canales"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/zapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   OK para cambiar"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lista horizontal de canales -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvZapping"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:clipToPadding="false" />
    </FrameLayout>

</FrameLayout>
