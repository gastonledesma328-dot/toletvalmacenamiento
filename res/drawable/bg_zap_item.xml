<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- FOCUS / SELECTED: gris oscuro + borde visible -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#40464E"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="#8FA2B2"/>
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#40464E"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="#8FA2B2"/>
        </shape>
    </item>

    <!-- PRESSED: un toque más claro al presionar -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A3F46"/>
            <corners android:radius="16dp"/>
            <stroke android:width="2dp" android:color="#7A8A98"/>
        </shape>
    </item>

    <!-- NORMAL (tu shape original): sutil translúcido -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF"/>
            <stroke android:width="2dp" android:color="#66FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</selector>
