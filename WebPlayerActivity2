    /** Navegación DPAD en la página (promueve controles a focusables) */
    private fun injectFocusAndSpatialNavLite() {
        val js = """
(function(){
  try{
    if (window.__TV_DPAD_LITE__) return;
    window.__TV_DPAD_LITE__ = true;

    function visible(el){
      if(!el) return false;
      var cs=getComputedStyle(el);
      if(cs.display==='none'||cs.visibility==='hidden'||el.disabled) return false;
      if(cs.opacity && parseFloat(cs.opacity)<0.12) return false;
      if(cs.pointerEvents==='none') return false;
      var r=el.getBoundingClientRect();
      return (r.width>=20 && r.height>=20 && r.bottom>=0 && r.right>=0 &&
              r.top<=(innerHeight||document.documentElement.clientHeight) &&
              r.left<=(innerWidth||document.documentElement.clientWidth));
    }

    function markFocusables(){
      var q='a[href],button,[role="button"],[role="link"],[onclick],select,summary,input,textarea';
      var els=[].slice.call(document.querySelectorAll(q)).filter(visible);
      els.forEach(function(el){
        if (el.tabIndex < 0) el.setAttribute('tabindex','0');
        el.setAttribute('data-tv-focus','1');
      });
      if (!document.getElementById('__TV_MILD_FOCUS__')){
        var s=document.createElement('style'); s.id='__TV_MILD_FOCUS__';
        s.textContent='[data-tv-focus]:focus{outline:2px solid rgba(0,150,255,.9);outline-offset:3px;border-radius:6px}';
        document.head.appendChild(s);
      }
    }

    function rect(el){ var r=el.getBoundingClientRect(); return {l:r.left,t:r.top,r:r.right,b:r.bottom,w:r.width,h:r.height,cx:(r.left+r.right)/2,cy:(r.top+r.bottom)/2}; }
    function focusables(){
      var q='[tabindex]:not([tabindex="-1"]),a[href],button,input,select,textarea,summary,[role="button"],[role="link"]';
      return [].slice.call(document.querySelectorAll(q)).filter(visible);
    }
    function spatial(dir){
      var cur=(document.activeElement && document.activeElement!==document.body)?document.activeElement:null;
      var list=focusables();
      if(!list.length) return false;
      if(!cur){ list[0].focus({preventScroll:true}); return true; }

      var cr=rect(cur), cand=[];
      list.forEach(function(el){
        if(el===cur) return;
        var rr=rect(el), inDir=false, primary=1e9, secondary=1e9;
        if (dir==='left'  && rr.r<=cr.l){ inDir=true; primary=cr.l-rr.r; secondary=Math.abs(rr.cy-cr.cy); }
        if (dir==='right' && rr.l>=cr.r){ inDir=true; primary=rr.l-cr.r; secondary=Math.abs(rr.cy-cr.cy); }
        if (dir==='up'    && rr.b<=cr.t){ inDir=true; primary=cr.t-rr.b; secondary=Math.abs(rr.cx-cr.cx); }
        if (dir==='down'  && rr.t>=cr.b){ inDir=true; primary=rr.t-cr.b; secondary=Math.abs(rr.cx-cr.cx); }
        if (inDir){ cand.push({el:el, score: primary*1000 + secondary}); }
      });
      if(!cand.length) return false;
      cand.sort(function(a,b){ return a.score-b.score; });
      var next=cand[0].el;
      if(next){ next.focus({preventScroll:true}); next.scrollIntoView({block:'nearest',inline:'nearest'}); return true; }
      return false;
    }

    document.addEventListener('keydown', function(e){
      var k=e.key, c=e.keyCode||e.which, handled=false;

      if (k==='ArrowLeft'||c===37)  handled = spatial('left');
      else if (k==='ArrowRight'||c===39) handled = spatial('right');
      else if (k==='ArrowUp'||c===38)    handled = spatial('up');
      else if (k==='ArrowDown'||c===40)  handled = spatial('down');
      else if (k==='Enter'||k===' '||c===13||c===32){
        var el=document.activeElement; 
        if(el && visible(el)){
          try{
            if (typeof el.click==='function') el.click();
            else el.dispatchEvent(new MouseEvent('click',{bubbles:true,cancelable:true}));
          }catch(_){}
          handled = true;
        }
      }
      if (handled){ e.preventDefault(); e.stopPropagation(); }
    }, true);

    function tick(){ try{ markFocusables(); }catch(_){ } }
    tick(); setTimeout(tick,700); setTimeout(tick,1500); setInterval(tick,2500);
  }catch(e){}
})();
    """.trimIndent()
        webView.evaluateJavascript(js, null)
    }

    /** Bridge de fullscreen: refuerza autoplay/unmute/focus cuando cambia fullscreen */
    private fun injectFullscreenBridge() {
        if (!this::webView.isInitialized) return
        val js = """
      (function(){
        try{
          if (window.__FS_BRIDGE__) return;
          window.__FS_BRIDGE__ = true;
          function emit(){ try { AndroidBridge.onUserPlay(); } catch(e){} }
          document.addEventListener('fullscreenchange', emit, true);
          document.addEventListener('webkitfullscreenchange', emit, true);
        }catch(e){}
      })();
    """.trimIndent()
        webView.evaluateJavascript(js, null)
    }


    private fun injectOverlayKillerSoft() {
        val js = """
          (function(){
            try{
              var bad = [
                '[class*="overlay"]','[id*="overlay"]','[class*="modal"]','[id*="modal"]',
                '.ad','.ads','.advert','.jw-rightclick','.video-ads','.ytp-paid-content-overlay',
                '[class*="popup"]','[id*="popup"]'
              ];
              function looksLikePlayer(n){
                try{
                  if (n.querySelector && n.querySelector('video')) return true;
                  var t = (n.textContent||'').toLowerCase();
                  if (t.includes('reproductor')||t.includes('player')) return true;
                }catch(e){}
                return false;
              }
              function hideAll(){
                bad.forEach(function(sel){
                  document.querySelectorAll(sel).forEach(function(n){
                    try{
                      var r=n.getBoundingClientRect(), st=getComputedStyle(n);
                      if(r.width>160 && r.height>120 && st.position!=='static' && !looksLikePlayer(n)){
                        n.style.setProperty('display','none','important');
                        n.style.setProperty('visibility','hidden','important');
                        n.style.setProperty('pointer-events','none','important');
                      }
                    }catch(e){}
                  });
                });
              }
              hideAll(); setTimeout(hideAll,600); setInterval(hideAll,2500);
            }catch(e){}
          })();
        """.trimIndent()
        webView.evaluateJavascript(js, null)
    }

