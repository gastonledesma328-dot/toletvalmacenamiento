    // Detección
    private var sniffWhitelist: Array<String> = arrayOf(".mpd", ".ism/manifest", ".mp4", ".m3u8")
    private var sniffBlacklist: Array<String> = arrayOf("blob:", "data:")

    // Handoff guard
    @Volatile private var didHandoff = false

    companion object {
        private val denyHandoffHosts: MutableSet<String> = mutableSetOf()
