    /** Clickea en serie botones de SERVIDOR (no idioma) hasta que __NATIVE_FOUND__ sea true */
    private fun injectAutoCycleServers() {
        val js = """
    (function(){
      try{
        if (window.__SERVER_CYCLER__) { window.__SERVER_CYCLER__.kick && window.__SERVER_CYCLER__.kick(); return; }

        window.__NATIVE_FOUND__ = !!window.__NATIVE_FOUND__;

        function visible(el){
          if(!el) return false;
          var cs=getComputedStyle(el);
          if(cs.display==='none'||cs.visibility==='hidden'||el.disabled) return false;
          if(cs.opacity && parseFloat(cs.opacity)<0.12) return false;
          if(cs.pointerEvents==='none') return false;
          var r=el.getBoundingClientRect();
          return (r.width>=20 && r.height>=20 && r.bottom>=0 && r.right>=0 &&
                  r.top<=(innerHeight||document.documentElement.clientHeight) &&
                  r.left<=(innerWidth||document.documentElement.clientWidth));
        }

        var HOST_WORDS = [
          "vidhide","streamwish","filemoon","mixdrop","streamtape","dood","okru","ok.ru","uqload","vidoza",
          "sbplay","streamsb","gcloud","upcloud","wolfstream","vidcloud","streamlare","sendvid","megacloud",
          "pixeldrain","hydrax","fastream","mcloud","voe","mp4upload","megaup","zippy","upload","anbalancer","sensa"
        ];
        var SERVER_RX = /(servidor|server|mirror|source|fuente|host|opci[oó]n|enlace|link|player|reproductor|watch|1080p|720p|hd|ver\b|play\b)/i;
        var LANGUAGE_RX = /(latino|castellano|espa[nñ]ol|\bes\b|english|\ben\b|ingl[eé]s|portugu[eé]s|\bpt\b|\bbr\b|subt[ií]t|sub\b|audio|dual|idioma|language|vose|vos|esp|lat|cast)/i;
        var FLAG_RX = /[\uD83C][\uDDE6-\uDDFF][\uD83C][\uDDE6-\uDDFF]/; // banderitas 🇦🇷🇪🇸 etc
        var BAD_RX = /(login|register|sign[- ]?in|sign[- ]?up|cerrar|close|cookie|gdpr|policy|report|share|like|promo|banner|omitir|skip|download|descargar|advert)/i;

        function looksLikeButton(el){
          var cs=getComputedStyle(el);
          var br=parseFloat(cs.borderRadius)||0;
          var cur=cs.cursor||"";
          var disp=cs.display||"";
          var bg=cs.backgroundImage||cs.backgroundColor||"";
          return (cur.indexOf('pointer')>=0) || (br>=6) || (disp==='inline-block'||disp==='flex'||disp==='inline-flex') || (!!bg && bg!=='none');
        }

        function isLanguageContext(el){
          var cur=el, hops=0;
          while(cur && hops<3){
            var t=((cur.getAttribute&&(cur.getAttribute('data-label')||cur.getAttribute('aria-label')))||cur.textContent||"").toLowerCase();
            if (LANGUAGE_RX.test(t) || FLAG_RX.test(t)) return true;
            cur=cur.parentElement; hops++;
          }
          return false;
        }

        function normalizeClickable(el){
          var base=el, cur=el, best=el, baseR=el.getBoundingClientRect(), baseA=baseR.width*baseR.height;
          for (var i=0;i<6 && cur && cur!==document.body && cur!==document.documentElement; i++){
            var r=cur.getBoundingClientRect(), a=r.width*r.height;
            var looks = cur.tagName==='A'||cur.tagName==='BUTTON'||cur.hasAttribute('onclick')||
                        cur.getAttribute('role')==='button'||cur.getAttribute('role')==='link';
            var areaOk = a <= baseA*8;
            if (visible(cur) && (looks || areaOk)) best = cur;
            cur = cur.parentElement;
          }
          return best;
        }

        function scoreCandidate(el){
          if(!visible(el)) return null;
          el = normalizeClickable(el);

          var t=(el.innerText||el.textContent||el.ariaLabel||el.title||"").trim();
          var tt=t.toLowerCase();
          var cls=(el.className||'').toString().toLowerCase();
          var id =(el.id||'').toString().toLowerCase();
          var href=(el.getAttribute && (el.getAttribute('href')||'')) || '';
          var dataKeys = Object.keys(el.dataset||{});
          var r=el.getBoundingClientRect(), area=r.width*r.height;

          if (BAD_RX.test(tt+" "+cls+" "+id)) return null;
          if (LANGUAGE_RX.test(tt) || FLAG_RX.test(tt) || isLanguageContext(el)) return null;

          var hostHit = HOST_WORDS.some(function(w){w=w.toLowerCase(); return tt.includes(w)||cls.includes(w)||id.includes(w)||(href.toLowerCase().includes(w));});
          var mainHit = SERVER_RX.test(tt)||SERVER_RX.test(cls)||SERVER_RX.test(id);
          var dataHit = dataKeys.some(function(k){ return /server|src|url|host|id|file/.test(k); });

          var big = (r.width>=110 && r.height>=36) || area>=5200 || looksLikeButton(el);

          var s = 0;
          if (hostHit) s += 70;
          if (mainHit) s += 50;
          if (dataHit) s += 30;
          if (big)     s += 30;
          s += Math.min(area/1500, 25);  // bonus por tamaño
          // leve penalización por textos genéricos cortos
          if (tt.length<=2) s -= 10;

          if (s < 25) return null; // filtro de ruido
          return {el: el, score: s, area: area, big: big, text: tt};
        }

        function collectCandidates(){
          var raw = Array.prototype.slice.call(document.querySelectorAll('a,button,[role="button"],[role="link"],[onclick],li,div'));
          var arr = [];
          for (var i=0;i<raw.length;i++){
            var c=scoreCandidate(raw[i]);
            if (c) arr.push(c);
          }
          // dedupe por nodo
          var seen=new Set(), out=[];
          for (var j=0;j<arr.length;j++){
            var n=arr[j];
            if (!seen.has(n.el)){ seen.add(n.el); out.push(n); }
          }
          // ordenar por score y área (desc)
          out.sort(function(a,b){
            if (b.score!==a.score) return b.score-a.score;
            return b.area-a.area;
          });
          return out;
        }

        function clickEl(el){
          try{ el.scrollIntoView({block:'center', inline:'center', behavior:'instant'}); }catch(_){}
          try{ el.focus({preventScroll:true}); }catch(_){}
          try{ if (typeof el.click==='function') el.click(); }catch(_){}
          try{
            var r=el.getBoundingClientRect();
            var x=Math.round(r.left+r.width/2), y=Math.round(r.top+r.height/2);
            ['mousedown','mouseup','click'].forEach(function(type){
              var e=new MouseEvent(type,{bubbles:true,cancelable:true,clientX:x,clientY:y,buttons:1});
              (document.elementFromPoint(x,y)||el).dispatchEvent(e);
            });
          }catch(_){}
        }

        var list=collectCandidates();
        var idx=0, running=false, stop=false;

        function step(){
          if (stop || window.__NATIVE_FOUND__) return;
          if (idx>=list.length){ stop=true; return; }
          running=true;
          var item=list[idx++];
          clickEl(item.el);
          try{ // esto dispara unmute/focus/sniffer desde tu lado
            AndroidBridge.onUserPlay && AndroidBridge.onUserPlay();
          }catch(_){}

          var tries=0;
          (function waitLoop(){
            if (stop || window.__NATIVE_FOUND__) { running=false; return; }
            if (++tries>=5){ // ~2.5s
              setTimeout(step, 250);
            } else {
              setTimeout(waitLoop, 500);
            }
          })();
        }

        function kick(){
          if (stop) return;
          if (!running){
            // refrescar candidatos por si el DOM cambió
            list = collectCandidates();
            idx = 0;
            step();
          }
        }

        window.__SERVER_CYCLER__ = { kick:kick, stop:function(){stop=true;} };

        // arranque + reintentos por si el DOM se arma tarde
        setTimeout(kick, 200);
        setTimeout(kick, 900);
        setTimeout(kick, 1800);
        setTimeout(kick, 3200);
        setTimeout(kick, 5200);

      }catch(e){}
    })();
    """.trimIndent()
        webView.evaluateJavascript(js, null)
    }



