    private fun injectVideoHealthWatchdog() {
        val js = """
        (function(){
          try{
            if(window.__VID_WATCHDOG__) return;
            window.__VID_WATCHDOG__=true;
            var stuck=0,last=0;
            function recover(v){
              try{ v.play().catch(()=>{}); if(v.readyState<2) v.load(); }catch(_){}
              try{ if(window.hls && hls.recoverMediaError) hls.recoverMediaError(); }catch(_){}
              try{ if(typeof jwplayer==='function'){ var jw=jwplayer(); if(jw&&jw.play) jw.play(); } }catch(_){}
            }
            function loop(){
              var v=document.querySelector('video');
              if(!v){ setTimeout(loop,1200); return; }
              var ct=v.currentTime||0;
              if(!v.paused && !v.ended){
                if(Math.abs(ct-last)<0.05) stuck++; else stuck=0;
              } else stuck=0;
              last=ct;
              if(stuck>=5){ recover(v); stuck=0; }
              setTimeout(loop,1500);
            }
            setTimeout(loop,1600);
          }catch(e){}
        })();
    """.trimIndent()
